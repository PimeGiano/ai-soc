digraph Interfaces {
graph [rankdir=LR];
node [shape=record,fontname="Microsoft YaHei",fontsize=12];
parent [label="{{<l0> clk (1)|<l1> rst (1)|<l2> reg_valid (1)|<l3> reg_addr (8)|<l4> reg_wdata (32)|<l5> reg_wstrb (4)|<l6> reg_ready (1)|<l7> reg_rdata (32)|<l8> dma_valid (1)|<l9> dma_addr (32)|<l10> dma_wdata (32)|<l11> dma_wstrb (4)|<l12> dma_ready (1)|<l13> dma_rdata (32)}|det_accelerator.sv\n|{<r0> prefetch cfg/start/consume (32/31/6/1)|<r1> prefetch busy/done (1/1)|<r2> prefetch read req (1/32)|<r3> prefetch read resp (1/32)|<r4> prefetch write (1/1/13/32/4)|<r5> X/W write (1/2/9/32/4)|<r6> X/W read_addr (36/36)|<r7> X/W read_data (128/128)|<r8> core control/A/B (1/1/4/32/1/32/32)|<r9> core result (32)|<r10> input_q cfg/sample (31/6/1/8/16)|<r11> input_q handshake/data (1/1/1/8)|<r12> output_q inputs (32/31/6)|<r13> output_q result (8)}}"];
pf [label="{{<l0> cfg/start/consume (32/31/6/1)|<l1> busy/done (1/1)|<l2> read req (1/32)|<l3> read resp (1/32)|<l4> write (1/1/13/32/4)}|tile_prefetch.sv\n|{<r0> input_quant inputs (32/31/6)|<r1> input_quant result (8)}}"];
banks [label="{{<l0> write ×4 (1/2/9/32/4)|<l1> read_addr X/W (36/36)}|banked_scratch.sv\n|{<r0> read_data X/W (128/128)}}"];
core [label="{{<l0> clear/restore/index/data/step/A/B (1/1/4/32/1/32/32)}|conv_core.sv\n|{<r0> result (32)}}"];
fq [label="{{<l0> cfg/sample (31/6/1/8/16)|<l1> handshake/data (1/1/1/8)}|fuse_requant.sv\n|{<r0> q inputs (32/31/6)|<r1> q result (8)}}"];
q [label="{{<l0> output_q inputs (32/31/6)|<l1> input_q.q inputs (32/31/6)|<l2> prefetch.input_quant inputs (32/31/6)}|requant.sv\n|{<r0> output_q result (8)|<r1> input_q.q result (8)|<r2> prefetch.input_quant result (8)}}"];
"external_clk" [shape=plaintext,label="clk (1) in"];
"external_rst" [shape=plaintext,label="rst (1) in"];
"external_reg_valid" [shape=plaintext,label="reg_valid (1) in"];
"external_reg_addr" [shape=plaintext,label="reg_addr (8) in"];
"external_reg_wdata" [shape=plaintext,label="reg_wdata (32) in"];
"external_reg_wstrb" [shape=plaintext,label="reg_wstrb (4) in"];
"external_reg_ready" [shape=plaintext,label="reg_ready (1) out"];
"external_reg_rdata" [shape=plaintext,label="reg_rdata (32) out"];
"external_dma_valid" [shape=plaintext,label="dma_valid (1) out"];
"external_dma_addr" [shape=plaintext,label="dma_addr (32) out"];
"external_dma_wdata" [shape=plaintext,label="dma_wdata (32) out"];
"external_dma_wstrb" [shape=plaintext,label="dma_wstrb (4) out"];
"external_dma_ready" [shape=plaintext,label="dma_ready (1) in"];
"external_dma_rdata" [shape=plaintext,label="dma_rdata (32) in"];
"external_clk" -> parent:l0 [color=red];
"external_rst" -> parent:l1 [color=red];
"external_reg_valid" -> parent:l2 [color=red];
"external_reg_addr" -> parent:l3 [color=red];
"external_reg_wdata" -> parent:l4 [color=red];
"external_reg_wstrb" -> parent:l5 [color=red];
parent:l6 -> "external_reg_ready" [color=red];
parent:l7 -> "external_reg_rdata" [color=red];
parent:l8 -> "external_dma_valid" [color=red];
parent:l9 -> "external_dma_addr" [color=red];
parent:l10 -> "external_dma_wdata" [color=red];
parent:l11 -> "external_dma_wstrb" [color=red];
"external_dma_ready" -> parent:l12 [color=red];
"external_dma_rdata" -> parent:l13 [color=red];
parent:r0 -> pf:l0 [color=red];
parent:r3 -> pf:l3 [color=red];
pf:l1 -> parent:r1 [color=red];
pf:l2 -> parent:r2 [color=red];
pf:l4 -> parent:r4 [color=red];
parent:r5 -> banks:l0 [color=red];
parent:r6 -> banks:l1 [color=red];
banks:r0 -> parent:r7 [color=red];
parent:r8 -> core:l0 [color=red];
core:r0 -> parent:r9 [color=red];
parent:r10 -> fq:l0 [color=red];
fq:l1 -> parent:r11 [color=red];
parent:r12 -> q:l0 [color=red];
q:r0 -> parent:r13 [color=red];
fq:r0 -> q:l1 [color=red];
q:r1 -> fq:r1 [color=red];
pf:r0 -> q:l2 [color=red];
q:r2 -> pf:r1 [color=red];
}
