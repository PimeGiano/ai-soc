digraph Interfaces {
graph [rankdir=LR];
node [shape=record,fontname="Microsoft YaHei",fontsize=12];
cpu [label="{{<l0> clk (1)|<l1> resetn = !rst (1)|<l2> mem_ready (1)|<l3> mem_rdata (32)}|picorv32.v\n|{<r0> mem_valid (1)|<r1> mem_instr (1)|<r2> mem_addr (32)|<r3> mem_wstrb (4)|<r4> mem_wdata (32)|<r5> trap (1)}}"];
cache [label="{{<l0> cpu_valid (1)|<l1> cpu_instr (1)|<l2> cpu_addr (32)|<l3> cpu_wstrb (4)|<l4> cpu_ready (1)|<l5> cpu_rdata (32)}|instruction_cache.sv\n|{<r0> clk (1)|<r1> rst (1)|<r2> bus_valid (1)|<r3> bus_ready (1)|<r4> bus_rdata (32)}}"];
"external_clk" [shape=plaintext,label="clk (1) in"];
"external_rst" [shape=plaintext,label="rst (1) in"];
"external_cbr" [shape=plaintext,label="cbr (1) in"];
"external_cbd" [shape=plaintext,label="cbd (32) in"];
"external_trap" [shape=plaintext,label="trap (1) out"];
"external_cbv" [shape=plaintext,label="cbv (1) out"];
"external_ci" [shape=plaintext,label="ci (1) out"];
"external_ca" [shape=plaintext,label="ca (32) out"];
"external_cw" [shape=plaintext,label="cw (32) out"];
"external_cs" [shape=plaintext,label="cs (4) out"];
"external_clk" -> cache:r0 [color=red];
"external_rst" -> cache:r1 [color=red];
"external_clk" -> cpu:l0 [color=red];
"external_rst" -> cpu:l1 [color=red];
cpu:r0 -> cache:l0 [color=red];
cpu:r1 -> cache:l1 [color=red];
cpu:r2 -> cache:l2 [color=red];
cpu:r3 -> cache:l3 [color=red];
cache:l4 -> cpu:l2 [color=red];
cache:l5 -> cpu:l3 [color=red];
"external_cbr" -> cache:r3 [color=red];
"external_cbd" -> cache:r4 [color=red];
cache:r2 -> "external_cbv" [color=red];
cpu:r5 -> "external_trap" [color=red];
cpu:r1 -> "external_ci" [color=red];
cpu:r2 -> "external_ca" [color=red];
cpu:r4 -> "external_cw" [color=red];
cpu:r3 -> "external_cs" [color=red];
}
