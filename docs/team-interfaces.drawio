 vertex="1" parent="1"><mxGeometry x="100" y="1715" width="988" height="34" as="geometry" /></mxCell><mxCell id="t187" value="X/W 共四个同型存储实例，示例连 X 读接口；前台/后台写入须经过控制器的 bank/地址映射。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1765" width="938" height="34" as="geometry" /></mxCell><mxCell id="t188" value="池化是独立外设，仅通过 CSR / DMA 接系统总线，不将其伪接成卷积后级流水。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1815" width="803" height="34" as="geometry" /></mxCell><mxCell id="t189" value="图中仅标主要跨块接口；配置、token、完整握手及所有位宽见 Excel 端口表。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1865" width="775" height="34" as="geometry" /></mxCell><mxCell id="t190" value="红线为主要连接，交叉无圆点表示不相连；同名 clk/rst、CSR/DMA 接系统页网络。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontFamily=Microsoft YaHei;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="1915" width="833" height="34" as="geometry" /></mxCell><mxCell id="t191" value="A 系统/缓存/总线  ·  B 控制/存储/预取  ·  C MAC/定点  ·  D 池化/固件/模型联调" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontFamily=Microsoft YaHei;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="2063" width="865" height="36" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>