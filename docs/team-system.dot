digraph Interfaces {
graph [rankdir=LR];
node [shape=record,fontname="Microsoft YaHei",fontsize=12];
cpu [label="{{<l0> clk (1)|<l1> rst (1)|<l2> cbr / cbd (1/32)}|CPU + I-cache\nA|{<r0> cbv / ca / cw / cs (1/32/32/4)|<r1> ci (1)|<r2> trap (1)}}"];
bus [label="{{<l0> cbv / ca / cw / cs (1/32/32/4)|<l1> cbr / cbd (1/32)|<l2> conv DMA req (1/32/32/4)|<l3> conv DMA resp (1/32)|<l4> conv CSR req (1/8/32/4)|<l5> conv CSR resp (1/32)|<l6> pool DMA req (1/32/32/4)|<l7> pool DMA resp (1/32)|<l8> pool CSR req (1/8/32/4)|<l9> pool CSR resp (1/32)}|两级仲裁 / 地址译码\nA（顶层逻辑分组）|{<r0> mem_valid (1)|<r1> mem_addr (32)|<r2> mem_wdata (32)|<r3> mem_wstrb (4)|<r4> mem_ready (1)|<r5> mem_rdata (32)|<r6> dr / pool_dr (1/1)|<r7> reg_select / pool_select (1/1)}}"];
conv [label="{{<l0> CSR req (1/8/32/4)|<l1> CSR resp (1/32)}|det_accelerator\nB / C|{<r0> DMA req (1/32/32/4)|<r1> DMA resp (1/32)}}"];
pool [label="{{<l0> CSR req (1/8/32/4)|<l1> CSR resp (1/32)}|pool_accelerator\nD|{<r0> DMA req (1/32/32/4)|<r1> DMA resp (1/32)}}"];
tags [label="{{<l0> ci (1)|<l1> dr / pool_dr (1/1)|<l2> reg_select / pool_select (1/1)}|访问统计标记\n顶层组合逻辑|{<r0> mem_dma (1)|<r1> mem_instr (1)}}"];
"external_clk" [shape=plaintext,label="clk (1) in"];
"external_rst" [shape=plaintext,label="rst (1) in"];
"external_mem_ready" [shape=plaintext,label="mem_ready (1) in"];
"external_mem_rdata" [shape=plaintext,label="mem_rdata (32) in"];
"external_trap" [shape=plaintext,label="trap (1) out"];
"external_mem_valid" [shape=plaintext,label="mem_valid (1) out"];
"external_mem_addr" [shape=plaintext,label="mem_addr (32) out"];
"external_mem_wdata" [shape=plaintext,label="mem_wdata (32) out"];
"external_mem_wstrb" [shape=plaintext,label="mem_wstrb (4) out"];
"external_mem_dma" [shape=plaintext,label="mem_dma (1) out"];
"external_mem_instr" [shape=plaintext,label="mem_instr (1) out"];
"external_clk" -> cpu:l0 [color=red];
"external_rst" -> cpu:l1 [color=red];
cpu:r0 -> bus:l0 [color=red];
bus:l1 -> cpu:l2 [color=red];
cpu:r2 -> "external_trap" [color=red];
cpu:r1 -> tags:l0 [color=red];
bus:r0 -> "external_mem_valid" [color=red];
bus:r1 -> "external_mem_addr" [color=red];
bus:r2 -> "external_mem_wdata" [color=red];
bus:r3 -> "external_mem_wstrb" [color=red];
"external_mem_ready" -> bus:r4 [color=red];
"external_mem_rdata" -> bus:r5 [color=red];
bus:r6 -> tags:l1 [color=red];
bus:r7 -> tags:l2 [color=red];
tags:r0 -> "external_mem_dma" [color=red];
tags:r1 -> "external_mem_instr" [color=red];
conv:r0 -> bus:l2 [color=red];
conv:l1 -> bus:l5 [color=red];
bus:l3 -> conv:r1 [color=red];
bus:l4 -> conv:l0 [color=red];
pool:r0 -> bus:l6 [color=red];
pool:l1 -> bus:l9 [color=red];
bus:l7 -> pool:r1 [color=red];
bus:l8 -> pool:l0 [color=red];
}
